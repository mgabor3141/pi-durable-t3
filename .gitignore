# Dependencies and build output.
node_modules/
dist/
*.log

# Scratch notes; never published.
.memory/

# T3 artifacts produced by `pnpm setup:t3` — all reproducible from the pinned commit
# (dev/setup-t3.sh), so they are never committed.
/vendor/
/web-dist/
/.t3-cache/

# Test roots are created under $TMPDIR, never in the repo. A run's durable.db, models-store.json,
# and t3-auth/ live under the env root (~/.pi/durable-t3), not here.
.DS_Store
