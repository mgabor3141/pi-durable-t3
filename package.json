{
	"name": "pi-durable-t3",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "T3 Code as a frontend for pi-durable (experimental prototype).",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"start": "node --experimental-strip-types examples/coding-agent/src/host.ts",
		"setup:t3": "bash dev/setup-t3.sh",
		"smoke": "bash dev/browser-smoke.sh"
	},
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@effect/platform-node": "4.0.1",
		"@t3tools/contracts": "link:vendor/contracts",
		"effect": "4.0.1",
		"smol-toml": "1.9.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"playwright-core": "1.56.1",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"pnpm": {
		"overrides": {
			"effect": "4.0.1"
		}
	}
}
